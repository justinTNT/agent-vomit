{
  "modules": [
    {
      "module_name": "data_versioner",
      "class_name": "DataVersioner",
      "class_variations": ["DataVersioner"],
      "init_params": {
        "storage_path": "/tmp/test_versions",
        "chunk_size": 1000,
        "track_deltas": true,
        "compression": false
      },
      "tests": [
        {
          "name": "forward",
          "test_type": "forward",
          "args": [
            {
              "type": "tensor",
              "shape": [2, 10, 512],
              "dtype": "torch.float32",
              "requires_grad": false,
              "device": "cpu"
            },
            "test commit"
          ],
          "tolerance": 0.0001,
          "timeout": 10.0,
          "description": "forward test for DataVersioner.forward"
        },
        {
          "name": "load_method",
          "test_type": "method",
          "method_name": "load",
          "args": ["test_version_id"],
          "tolerance": 0.0001,
          "timeout": 10.0,
          "description": "method test for DataVersioner.load"
        },
        {
          "name": "diff_method", 
          "test_type": "method",
          "method_name": "diff",
          "args": ["version1", "version2"],
          "tolerance": 0.0001,
          "timeout": 10.0,
          "description": "method test for DataVersioner.diff"
        }
      ],
      "description": "Fixed config for data_versioner.DataVersioner",
      "dependencies": null
    },
